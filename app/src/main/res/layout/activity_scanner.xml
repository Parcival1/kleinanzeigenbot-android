<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/vorschau"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Zielrahmen in der Mitte -->
    <View
        android:id="@+id/rahmen"
        android:layout_width="300dp"
        android:layout_height="140dp"
        android:layout_gravity="center"
        android:background="@drawable/scan_rahmen" />

    <LinearLayout
        android:id="@+id/hinweis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/scan_erlaubnis_fehlt"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/hinweis_knopf"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/fertig_knopf"
            android:paddingHorizontal="20dp"
            android:text="@string/app_einstellungen_oeffnen"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- oben: schließen, Titel, Lampe -->
    <LinearLayout
        android:id="@+id/oben"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#66000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <ImageButton
            android:id="@+id/schliessen"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/rund_knopf"
            android:contentDescription="@string/kamera_schliessen"
            android:src="@drawable/ic_schliessen" />

        <TextView
            android:id="@+id/titel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/scan_titel"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/lampe"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/rund_knopf"
            android:contentDescription="@string/scan_lampe"
            android:src="@drawable/ic_lampe" />
    </LinearLayout>

    <!-- unten: Hinweis und Eintippen -->
    <LinearLayout
        android:id="@+id/unten"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#66000000"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp">

        <!-- „Suchen“: falsches Etikett. Die Kamera sucht weiter, nichts zu bestätigen. -->
        <LinearLayout
            android:id="@+id/falsch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/falsch_meldung"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:visibility="gone"
            android:accessibilityLiveRegion="assertive">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_falsch" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/suchen_falsch"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/falsch_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/hinweis_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/scan_hinweis"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/eintippen"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/knopf_leise"
            android:text="@string/scan_eintippen"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
