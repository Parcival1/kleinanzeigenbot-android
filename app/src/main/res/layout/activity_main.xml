<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wurzel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hintergrund"
    android:orientation="vertical">

    <!-- Fläche hinter der Statusleiste, Farbe wie der Kopf der Weboberfläche -->
    <View
        android:id="@+id/oben"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/kopf" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Nach unten wischen lädt die Seite neu -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/wischen"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <WebView
                android:id="@+id/web"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <ProgressBar
            android:id="@+id/fortschritt"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:indeterminate="false"
            android:max="100"
            android:progressTint="@color/akzent"
            android:progressBackgroundTint="@android:color/transparent"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/fehler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/hintergrund"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_wlan"
                    android:tint="@color/text_leise" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/fehler_titel"
                    android:textColor="@color/text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fehler_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.15"
                    android:textColor="@color/text_leise"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/erneut"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/knopf"
                    android:text="@string/erneut"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/adresse"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/knopf_leise"
                    android:text="@string/adresse_aendern"
                    android:textAllCaps="false"
                    android:textColor="@color/text"
                    android:textSize="16sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Fläche hinter der Navigationsleiste bzw. Tastatur -->
    <View
        android:id="@+id/unten"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/leiste" />
</LinearLayout>
