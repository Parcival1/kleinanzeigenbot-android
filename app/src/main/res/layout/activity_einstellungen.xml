<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wurzel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hintergrund"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/titel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/einstellungen"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/serveradresse"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Fest eingebaut (marke.properties SERVER), nicht änderbar. -->
        <TextView
            android:id="@+id/server_anzeige"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_leise"
            android:textIsSelectable="true"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/app_bereich"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_bereich"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_leise"
                android:textSize="14sp" />

            <Button
                android:id="@+id/updates"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/knopf_leise"
                android:text="@string/updates_suchen"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <Button
                android:id="@+id/neuigkeiten"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/knopf_leise"
                android:text="@string/was_ist_neu"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/quelle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_leise"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
